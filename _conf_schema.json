{
    "error": {
        "description": "【报错处理】",
        "type": "object",
        "hint": "全局拦截报错",
        "items": {
            "keywords": {
                "description": "检测报错所用关键词",
                "hint": "当 Bot 消息包含列表中任一关键词时，将触发拦截。留空则关闭报错处理",
                "type": "list",
                "default": [
                    "请求失败",
                    "出现异常"
                ]
            },
            "custom_msg": {
                "description": "原对话的消息",
                "hint": "当报错被拦截时，会在原对话中发送此消息。留空则不发送",
                "type": "string",
                "default": ""
            },
            "forward_umo": {
                "description": "转发目标会话 ID",
                "hint": "将报错信息转发到该会话。可用 sid 命令查看当前会话 ID。填 admin 表示转发给配置中的所有 Bot 管理员；留空则不转发",
                "type": "string",
                "default": "admin"
            }
        }
    },
    "reply": {
        "description": "【智能引用】",
        "type": "object",
        "hint": "当 Bot 准备回复的消息被他人插入新消息时，自动引用目标消息。支持 aiocqhttp 与 QQ 官方机器人",
        "items": {
            "threshold": {
                "description": "引用阈值",
                "hint": "设置“被插入多少条消息后触发引用”。设为 0 表示关闭引用功能。建议先关闭 AstrBot 自带 Reply 功能。QQ 官方机器人群聊仅能收到 @ 机器人的消息，计数也只统计这些消息",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 4,
                    "step": 1
                },
                "default": 1
            },
            "include_at": {
                "description": "引用时包含艾特",
                "hint": "开启后，在引用回复的同时会艾特被回复的人（仅 aiocqhttp）",
                "type": "bool",
                "default": false
            },
            "only_llm": {
                "description": "仅对 LLM 回复生效",
                "hint": "开启后，普通插件消息不会被引用",
                "type": "bool",
                "default": true
            }
        }
    },
    "markdown": {
        "description": "【Markdown 保护】",
        "type": "object",
        "hint": "消息会被渲染为 Markdown 时，跳过 AstrBot 原生分段回复，避免代码块、列表、表格被切碎",
        "items": {
            "skip_native_split": {
                "description": "Markdown 消息跳过原生分段",
                "hint": "检测到 LLM 回复包含 Markdown 格式（代码块、标题、列表、表格、粗体等）时整条发送。需要原生分段回复开启「仅对 LLM 结果生效」（默认开启）",
                "type": "bool",
                "default": true
            },
            "platforms": {
                "description": "渲染 Markdown 的平台",
                "hint": "填写平台适配器类型名，仅这些平台会被视为渲染 Markdown。消息被强制设为纯文本发送时不生效",
                "type": "list",
                "default": [
                    "qq_official"
                ]
            }
        }
    }
}
